# Telegram Configuration
# Obtain bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Obtain numeric user ID from @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_ID="123456789"

# Ollama Local Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="gemma2:2b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_VISION_MODEL="llava"

# Storage Paths (relative to project root or absolute)
SQLITE_DB_PATH="./data/slothbox.db"
MEDIA_DIR="./data/media"

# Optional Service Integrations (leave empty if not using)
BACKBOARD_API_KEY=""
SENTRY_AUTH_TOKEN=""
ELEVENLABS_API_KEY=""
